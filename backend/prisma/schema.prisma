generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id            String         @id @default(uuid())
  title         String
  slug          String         @unique
  description   String
  features      String[]       @default([])
  fabric        String?
  colors        String[]       @default([])
  images        String[]       @default([])
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isFeatured    Boolean        @default(false)
  isAvailable   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@map("products")
}

model Service {
  id          String   @id @default(uuid())
  title       String   @unique
  slug        String   @unique
  description String
  icon        String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model Announcement {
  id        String    @id @default(uuid())
  title     String
  content   String
  badge     String?
  linkUrl   String?
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("announcements")
}

model SiteSetting {
  id             String   @id @default("default")
  businessName   String   @default("Hijab World")
  tagline        String?
  aboutText      String?
  whatsappNumber String?
  instagramUrl   String?
  facebookUrl    String?
  tiktokUrl      String?
  youtubeUrl     String?
  emailAddress   String?
  phoneNumber    String?
  address        String?
  bannerText     String?
  showBanner     Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@map("site_settings")
}