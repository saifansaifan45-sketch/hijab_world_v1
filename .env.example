# ========================================================
# HIJAB WORLD - MASTER ENVIRONMENT CONFIGURATION
# ========================================================

# Application Mode & Ports
NODE_ENV=development
PORT=4000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# --------------------------------------------------------
POSTGRES_USER=hijab_user
POSTGRES_PASSWORD=hijab_secret_password
POSTGRES_DB=hijab_world_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://hijab_user:hijab_secret_password@localhost:5432/hijab_world_db?schema=public"

# --------------------------------------------------------
# JWT & Authentication Secrets
# --------------------------------------------------------
JWT_ACCESS_SECRET=hijab_world_super_secret_access_jwt_key_2026_change_in_production
JWT_REFRESH_SECRET=hijab_world_super_secret_refresh_jwt_key_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Initial Super Admin Seed Credentials
INITIAL_ADMIN_EMAIL=admin@hijabworld.com
INITIAL_ADMIN_PASSWORD=AdminSecurePassword2026!
INITIAL_ADMIN_NAME="Hijab World Administrator"

# --------------------------------------------------------
# Cloudinary (Media / Product Images Uploads)
# --------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --------------------------------------------------------
# Brand, Contact & Social Media Information
# --------------------------------------------------------
BRAND_NAME="Hijab World"
TAGLINE="Elegance in Modesty"
WHATSAPP_NUMBER="+919876543210"
WHATSAPP_PREFILLED_MESSAGE="Hello Hijab World, I would like to inquire about your collection."
INSTAGRAM_URL="https://instagram.com/hijabworld.official"
FACEBOOK_URL="https://facebook.com/hijabworld.official"
TIKTOK_URL="https://tiktok.com/@hijabworld"
YOUTUBE_URL="https://youtube.com/@hijabworld"
CONCIERGE_EMAIL="contact@hijabworld.com"
PHONE_NUMBER="+919876543210"
STORE_ADDRESS="123 Modest Fashion Ave, City, Country"

# --------------------------------------------------------
# Security & Rate Limiting
# --------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=100
CORS_ORIGIN=http://localhost:3000
COOKIE_SECRET=hijab_world_cookie_secret_salt_2026

# Legacy Prototype PIN
ADMIN_PIN=1234